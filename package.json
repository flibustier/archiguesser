{
  "name": "archiguesser",
  "version": "2.4.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "vite",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:linux": "docker run -it --rm --ipc=host --volume=./:/mnt --volume=/mnt/node_modules --workdir=/mnt mcr.microsoft.com/playwright:v1.64.1-noble /bin/sh -c 'npm install -g pnpm@12.15.0 && pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store && pnpm exec playwright test --update-snapshots'",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.config.json",
    "build": "pnpm run type-check && vite build",
    "preview": "vite preview --port 4173",
    "deploy": "./scripts/deploy.sh",
    "convert": "./scripts/convert.sh",
    "convert:all": "for dir in $(ls -1 sources/ | grep -E '^[0-9]+$' | sort -n); do echo 'Processing $dir...'; pnpm run convert $dir; done",
    "download": "node ./scripts/download/cli.js"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "25.9.9",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "axios": "1.21.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "7.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
